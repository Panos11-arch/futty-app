# Copy to .env. Both values come from the Supabase dashboard under Project Settings > API.
# The anon key is a publishable key — it ships inside the app bundle and is safe to
# expose as long as row level security is enabled on every table.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Set once the app has a real App Store / Play Store listing — the
# team-invite share message includes it when present, and asks the recipient
# to get the link from you otherwise. See lib/invite.ts.
EXPO_PUBLIC_APP_DOWNLOAD_URL=

# Stripe publishable key (starts pk_test_... / pk_live_...) — from the Stripe
# dashboard under Developers > API keys. Safe to expose in the app bundle,
# same as the Supabase anon key above; it can only start a payment, never
# move money on its own. The matching secret key (sk_...) is NOT an env var
# here — it's set as a Supabase Edge Function secret instead (STRIPE_SECRET_KEY),
# same pattern as ASC_PRIVATE_KEY.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Sentry DSN (from sentry.io > Settings > Projects > Client Keys). Public by
# design — it only identifies where to send error reports, not a secret.
EXPO_PUBLIC_SENTRY_DSN=
