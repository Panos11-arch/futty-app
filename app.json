{
  "expo": {
    "name": "Futty",
    "slug": "futty-app",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/185f673b-393d-45ca-a7b5-bda0da4a0c8f"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "futtyapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.panosalepis.futtyapp",
      "deploymentTarget": "15.0",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:futty.app"
      ]
    },
    "android": {
      "package": "com.panosalepis.futtyapp",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "futty.app",
              "pathPrefix": "/p/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to unlock the app with Face ID."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-sqlite",
      "expo-notifications",
      "expo-iap",
      "expo-apple-authentication",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow $(PRODUCT_NAME) to access your contacts so it can show which of them are already on Futty."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow $(PRODUCT_NAME) to add your Futty games to your calendar and keep them up to date when a booking moves or is cancelled.",
          "remindersPermission": "Futty only adds your games to your calendar. It never reads or changes your reminders."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.panosalepis.futtyapp",
          "enableGooglePay": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Futty uses your photos so you can attach them in chats, and so venue staff can add pitch and menu pictures.",
          "microphonePermission": false,
          "cameraPermission": "Futty uses the camera to scan check-in and player codes, and to take photos you attach in chats."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Futty uses the camera to scan check-in and player codes, and to take photos you attach in chats.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "@react-native-community/datetimepicker",
      "@sentry/react-native",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Premium",
            "ios": "./assets/images/icon-premium.png",
            "android": {
              "foregroundImage": "./assets/images/android-icon-premium-foreground.png",
              "backgroundColor": "#000000"
            }
          }
        ]
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Futty uses your location only to show the weather and venues near you.",
          "locationAlwaysAndWhenInUsePermission": "Futty uses your location only to show the weather and venues near you.",
          "locationAlwaysPermission": "Futty uses your location only to show the weather and venues near you."
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "REPLACE_WITH_GOOGLE_MAPS_ANDROID_API_KEY"
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.panosalepis.futtyapp.ExpoWidgetsTarget",
          "groupIdentifier": "group.com.panosalepis.futtyapp",
          "enablePushNotifications": true,
          "widgets": []
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2436288039660225~6647523498",
          "iosAppId": "ca-app-pub-2436288039660225~4198161963",
          "delayAppMeasurementInit": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "185f673b-393d-45ca-a7b5-bda0da4a0c8f"
      }
    },
    "owner": "futty-app"
  }
}
